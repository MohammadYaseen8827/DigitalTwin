        "username": "Hector Perez",
        "userId": "amzn1.account.AE2TOPCCY36VPBQ7VUCVOLNPVNUQ",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AE2TOPCCY36VPBQ7VUCVOLNPVNUQ",
        "ratingScore": 5,
        "reviewTitle": "Looks great",
        "reviewDescription": "Really liked it. It's a very beautiful. My daughter loves it",
        "date": "2025-12-01",
        "position": 1,
        "reviewedIn": "Reviewed in the United States on December 1, 2025",
        "reviewId": "R1PGMXZQISN469",
        "reviewUrl": "https://www.amazon.com/gp/customer-reviews/R1PGMXZQISN469/ref=cm_cr_dp_d_rvw_ttl?ie=UTF8",
        "reviewImages": [],
        "reviewReaction": null,
