      {
        "username": "Linda Ivory",
        "userId": "amzn1.account.AHRQ6T6TJVIONX3RREM2EUWFLDAA",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AHRQ6T6TJVIONX3RREM2EUWFLDAA",
        "ratingScore": 5,
        "reviewTitle": "Silk scarf",
        "reviewDescription": "This item was purchased as a part of a Pollyanna. The person wanted a silk scarf. I love the pattern selections and the quality of the scarf at such a nice price was outstanding. Even the packaging was done very well, would definitely buy another.",
