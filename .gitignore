{
  "image": "https://m.media-amazon.com/images/I/616w9X6lXqL._AC_SX342_SY445_QL70_FMwebp_.jpg",
  "url": "https://www.amazon.com/dp/B0GCZD87X8",
  "name": "Croogo Winter Short Brim 5 Panel Cap Corduroy Trapper Hat with Ear Flaps for Men Warm Baseball Cap with Visor",
  "offers": {
