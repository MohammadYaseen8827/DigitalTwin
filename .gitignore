          }
        ]
      },
      {
        "username": "M.O. Smith",
        "userId": "amzn1.account.AGFQUR3I5ITYRQAZXQCVUDWIBRFQ",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AGFQUR3I5ITYRQAZXQCVUDWIBRFQ",
        "ratingScore": 5,
        "reviewTitle": "Nice detail on a cloth type, non paper material, decent 12x18 inch size",
        "reviewDescription": "Excellent rocket detail and notes which can easily be read. The printing is on a cloth type, non paper material which helps in a humid environment to prevent buckling. The size is a decent 12x18 inch size, perfect for hanging incase there is less room available.",
        "date": "2025-10-23",
        "position": 2,
