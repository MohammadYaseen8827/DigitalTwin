          }
        ]
      },
      {
        "username": "Amazon Customer",
        "userId": "amzn1.account.AEOJ2FKA7G6W6CSZAZCOBBC4FGGQ",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AEOJ2FKA7G6W6CSZAZCOBBC4FGGQ",
        "ratingScore": 5,
        "reviewTitle": "Gorgeous, well made wrap",
        "reviewDescription": "I rarely take the time to do reviews. This product deserves a review. I am so impressed on every level. The colors are gorgeous and it's reversible. I am 5'9\" and weigh 220 lb. It's a perfect length and I can completely wrap it around me with no problem. It's lightweight enough to make it easy to travel with or bring to a gathering in a bag in case I get cold. It is so well made. Many of the things I've gotten from other countries are very cheap and poorly made. This is the opposite. I will get many years of enjoyment and use from this beautiful wrap",
        "date": "2025-12-01",
        "position": 3,
        "reviewedIn": "Reviewed in the United States on December 1, 2025",
        "reviewId": "R340VFKGMT16B6",
        "reviewUrl": "https://www.amazon.com/gp/customer-reviews/R340VFKGMT16B6/ref=cm_cr_dp_d_rvw_ttl?ie=UTF8",
