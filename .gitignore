          }
        ]
      },
      {
        "username": "Brandon",
        "userId": "amzn1.account.AG7DI7PSTAO7BHKBNCCTON5LGQYQ",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AG7DI7PSTAO7BHKBNCCTON5LGQYQ",
        "ratingScore": 5,
        "reviewTitle": "Bring Van Gogh’s Starry Night into Your Life – Warm and Stylish!",
        "reviewDescription": "This Van Gogh “Starry Night” cashmere scarf completely exceeded my expectations! The design is absolutely stunning, blending the artistic beauty of the famous painting into something you can wear every day. The cashmere material is super soft, cozy, and keeps you warm—perfect for chilly weather. I gave it to my wife as a gift, and she absolutely loves it. Every time she wears it, she can’t stop talking about how gorgeous and high-quality it feels. The packaging was also really thoughtful and elegant, making it a great gift option. If you love art and want something both stylish and practical, this scarf is a must-have!",
        "date": "2025-01-11",
        "position": 3,
        "reviewedIn": "Reviewed in the United States on January 11, 2025",
        "reviewId": "R1W399BG0H3H6I",
        "reviewUrl": "https://www.amazon.com/gp/customer-reviews/R1W399BG0H3H6I/ref=cm_cr_dp_d_rvw_ttl?ie=UTF8",
