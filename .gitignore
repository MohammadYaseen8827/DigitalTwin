    "productPageReviews": [
      {
        "username": "Robert",
        "userId": "amzn1.account.AHU7YSMYGVP4WLIOBQXROTF3BOCQ",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AHU7YSMYGVP4WLIOBQXROTF3BOCQ",
        "ratingScore": 5,
        "reviewTitle": "Cloth like material",
        "reviewDescription": "The first thing I noticed about this is that it is not paper. This is more like a plastic type of fabric material. It kind of reminds me of the material that some casual placemats are made out of. Being that this is made from this material, this should last a long time. It should not be affected by water, or humidity. I also like that it is very hard to rip or tear it up. A paper version of this could easily be torn, but this one should last a long time. I really like this for the conversation piece that it is. It is definitely a piece of space history. I would love to see one with all of the nasa rockets as well. This is very nicely printed. I can not read the words on it, but if you spoke the language, I’m sure you could. That’s how nice the printing is.This was very east to use. You just unroll it and it is ready. I also rolled it up backwards to help it lay flat. This has a nice border around the entire photo making it easy to frame if you want. I am really excited to show this off to people who enjoy space themed items. Overall a great value for anyone looking to dress up their walls with a piece of history.",
        "date": "2025-09-23",
        "position": 1,
        "reviewedIn": "Reviewed in the United States on September 23, 2025",
        "reviewId": "R2WEXEBZD7OOU",
        "reviewUrl": "https://www.amazon.com/gp/customer-reviews/R2WEXEBZD7OOU/ref=cm_cr_dp_d_rvw_ttl?ie=UTF8",
        "reviewImages": [],
        "reviewReaction": "One person found this helpful",
        "isVerified": false,
        "isAmazonVine": false,
        "avatar": null,
        "variant": "Size: 18\"L x 12\"W",
