      {
        "username": "Anne",
        "userId": "amzn1.account.AGCLNPRJUO26WCVUVPS5ZS5CPBZQ",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AGCLNPRJUO26WCVUVPS5ZS5CPBZQ",
        "ratingScore": 5,
        "reviewTitle": "Absolutely beautiful!",
        "reviewDescription": "Gorgeous! Feels very sturdy and well stitched. Perfect for keeping the breeze off your shoulders this time of year. I'd love to have one in every color but this green is most definitely my favorite! 💝",
        "date": "2025-09-26",
        "position": 1,
        "reviewedIn": "Reviewed in the United States on September 26, 2025",
        "reviewId": "R2EFEMQ0SBVLSJ",
        "reviewUrl": "https://www.amazon.com/gp/customer-reviews/R2EFEMQ0SBVLSJ/ref=cm_cr_dp_d_rvw_ttl?ie=UTF8",
