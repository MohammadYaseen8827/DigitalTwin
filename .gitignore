      {
        "username": "A. Gilchrist",
        "userId": "amzn1.account.AET6JKGAFNN3NEYPFLJHHKXEII6A",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AET6JKGAFNN3NEYPFLJHHKXEII6A",
        "ratingScore": 5,
        "reviewTitle": "Gorgeous Scarf!",
        "reviewDescription": "This scarf is beautiful, soft, light but a great weight, versatile, and warming from a cool breeze.  I keep it in my purse.  The design and colors are pretty.  I purchased the touristy scene version.  I enjoy learning the different ways to tie it too.  It arrived professionally packaged which impressed me.  Great value for the money.  I hope the manufacturer will release more variety of prints.  I would definitely buy.  It makes a wonderful gift as well.  Highly recommended!",
        "date": "2025-05-21",
        "position": 2,
        "reviewedIn": "Reviewed in the United States on May 21, 2025",
        "reviewId": "RHKQY08UH41N2",
        "reviewUrl": "https://www.amazon.com/gp/customer-reviews/RHKQY08UH41N2/ref=cm_cr_dp_d_rvw_ttl?ie=UTF8",
        "reviewImages": [],
        "reviewReaction": "2 people found this helpful",
        "isVerified": false,
        "isAmazonVine": false,
        "avatar": "https://m.media-amazon.com/images/S/amazon-avatars-global/15ce50ac-3d35-46ab-a254-b95ce87b7cdf._CR0%2C0%2C500%2C500_SX460_.jpg",
        "variant": "Color: Antibes - 36\"",
        "variantAttributes": [
