      {
        "username": "A. Marsh",
        "userId": "amzn1.account.AFTN26ODQHBQ2QLWTPATI4LZ4RHA",
        "userProfileLink": "https://www.amazon.com/gp/profile/amzn1.account.AFTN26ODQHBQ2QLWTPATI4LZ4RHA",
        "ratingScore": 5,
        "reviewTitle": "Nice shawl",
        "reviewDescription": "Surprised at how much a love this shawl.  For the price I was not expecting to like it that much.",
