{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=DigitalTwin_Dev;Username=admin;Password=password;",
    "RedisConnection": "localhost:6379"
  },
  "Jwt": {
    "Key": "dev-secret-key-change-in-production",
    "Issuer": "DigitalTwinPlatform-Development",
    "Audience": "DigitalTwinPlatform-Users",
    "ExpirationMinutes": 43200
  },
  "ShapService": {
    "BaseUrl": "http://localhost:5001",
    "ApiKey": "dev-api-key",
    "TimeoutSeconds": 60
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000"
    ]
  },
  "FeatureFlags": {
    "EnableAdvancedAnalytics": true,
    "EnableSyntheticDataGeneration": true,
    "EnableRealTimeUpdates": true,
    "EnableDetailedLogging": true,
    "EnableDebugEndpoints": true
  },
  "Monitoring": {
    "EnableHealthChecks": true,
    "EnableMetrics": true,
    "EnableTracing": true,
    "SampleRate": 1.0
  },
  "Performance": {
    "EnableResponseCaching": false,
    "CacheDurationMinutes": 1,
    "MaxConcurrentRequests": 100,
    "RequestTimeoutSeconds": 60
  },
  "Security": {
    "RequireHttps": false,
    "EnableRateLimiting": false,
    "RateLimitPerMinute": 10000,
    "EnableCsp": false,
    "EnableHsts": false
  },
  "ML": {
    "ModelRetrainingIntervalHours": 1,
    "MinTrainingSamples": 10,
    "MaxTrainingSamples": 1000,
    "EnableModelVersioning": true,
    "ModelStoragePath": "./models/dev"
  },
  "Telemetry": {
    "EnableDetailedMetrics": true,
    "MetricsRetentionDays": 7,
    "EnablePerformanceCounters": true,
    "SampleRate": 1.0
  }
}