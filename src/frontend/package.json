{
  "name": "digital-twin-dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --noEmit",
    "preview": "vite preview --port 3000",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "prepare": "cypress install",
    "test:e2e": "playwright test",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 3000' http://localhost:3000 'cypress open --e2e'",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.vue --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@heroicons/vue": "^2.1.5",
    "@iconify-json/lucide": "^1.1.26",
    "@microsoft/signalr": "10.0.0",
    "@types/three": "^0.180.0",
    "axios": "^1.7.2",
    "date-fns": "^3.3.1",
    "echarts": "^5.5.0",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.338.0",
    "pinia": "^2.1.7",
    "three": "^0.159.0",
    "vue": "^3.4.15",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.186",
    "@playwright/test": "^1.42.1",
    "@tsconfig/node22": "^22.0.1",
    "@types/jsdom": "^20.0.1",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/eslint-plugin": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.17",
    "cypress": "^13.6.6",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-cypress": "^2.13.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-playwright": "^1.5.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^3.0.0",
    "eslint-plugin-vue": "^9.21.1",
    "eslint-plugin-vue-pug-sfc": "^1.0.0-alpha.20",
    "jsdom": "^24.0.0",
    "npm-run-all2": "^8.0.1",
    "postcss": "^8.4.33",
    "postcss-nesting": "^12.0.2",
    "prettier": "^3.2.5",
    "sass": "^1.71.0",
    "start-server-and-test": "^2.0.4",
    "typescript": "~5.3.3",
    "unplugin-icons": "^0.16.6",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.4",
    "vite-plugin-vue-devtools": "^7.2.5",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.0.6"
  }
}
