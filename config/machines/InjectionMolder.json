{
  "machineType": "InjectionMolder",
  "displayName": "Injection Molding Machine",
  "degradationModel": {
    "modelType": "Markov",
    "parameters": {
      "timeScale": 1.0
    },
    "modelSpecificSettings": {
      "transitionMatrix": [
        [1.0, 0.0, 0.0, 0.0],
        [0.05, 0.95, 0.0, 0.0],
        [0.0, 0.02, 0.98, 0.0],
        [0.0, 0.0, 0.01, 0.99]
      ]
    }
  },
  "sensorMappings": [
    {
      "sensorType": "temperature",
      "transferFunction": "baseTemp + degradationState * tempCoeff",
      "transferFunctionParameters": {
        "baseTemp": 180.0,
        "tempCoeff": 60.0
      },
      "noiseLevel": 3.0,
      "unit": "C"
    },
    {
      "sensorType": "pressure",
      "transferFunction": "basePressure + degradationState * pressureCoeff",
      "transferFunctionParameters": {
        "basePressure": 80.0,
        "pressureCoeff": 40.0
      },
      "noiseLevel": 2.5,
      "unit": "bar"
    }
  ],
  "failureThresholds": {
    "degradationThreshold": 0.3,
    "sensorThresholds": {
      "temperature": 250.0,
      "pressure": 150.0
    },
    "maxOperationalTime": null
  },
  "operationalParameters": {
    "typicalOperatingHours": 18,
    "maintenanceIntervalDays": 45
  }
}
